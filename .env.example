# 1. Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# 2. S3 Object Storage Bucket Configuration (AWS S3 or Neon S3 Storage)
STORAGE_PROVIDER=s3
S3_BUCKET=aisha-storage-bucket
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://your-storage-id.storage.c-9.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://your-bucket-domain.com
S3_SIGNED_URL_EXPIRES=604800

# 3. Optional Vercel Blob Storage Token (if not using S3)
# BLOB_READ_WRITE_TOKEN=

# 4. Admin Dashboard Credentials & Authentication
ADMIN_USERNAME=aisha_muhammad_ali_@7623
ADMIN_PASSWORD="aisha_MUHAMMAD@#!Ali"
SESSION_SECRET=replace-with-at-least-32-random-characters-secret

# 5. Optional Formspree Form ID for lead notification emails
# FORMSPREE_ID=
